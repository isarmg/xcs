[package]
name = "web-blake3-simd-check"
version = "0.0.0"
edition = "2024"
[workspace]
resolver = "2"
[lib]
crate-type = ["cdylib", "rlib"]
[dependencies]
blake3 = { path = "../src/foundation/blake3" }
[target.'cfg(target_arch = "wasm32")'.dependencies]
blake3 = { path = "../src/foundation/blake3", features = ["wasm32_simd"] }
[profile.dev]
debug = 0
incremental = false
[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1
