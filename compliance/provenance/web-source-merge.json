    "vendor/web/zxs-web-core/Cargo.toml": "[package]\nname = \"zxs-web-core\"\nversion = \"0.8.19\"\nedition = \"2021\"\nbuild = \"build.rs\"\nautotests = false\nlicense-file = \"README.md\"\ndescription = \"Project-specific browser CSR runtime\"\n\n[features]\ndefault = [\"csr\"]\ncsr = [\"zxs_web_macro/csr\", \"reactive_graph/effects\"]\n\n[dependencies]\nany_spawner = { path = \"../dependencies/any_spawner-0.3.0\", version = \"0.3.0\", features = [\"wasm-bindgen\"] }\neither_of = { path = \"../dependencies/either_of-0.1.9\", version = \"0.1.9\" }\nfutures = \"0.3\"\nleptos_dom = { path = \"../dependencies/leptos_dom-0.8.8\", version = \"0.8.8\" }\nzxs_web_macro = { package = \"zxs-web-macro\", path = \"../zxs-web-macro\", default-features = false, features = [\"csr\"] }\noco_ref = { path = \"../dependencies/oco_ref-0.2.1\", version = \"0.2.1\" }\nor_poisoned = { path = \"../dependencies/or_poisoned-0.1.0\", version = \"0.1.0\" }\npaste = { package = \"pastey\", version = \"=0.2.3\" }\nreactive_graph = { path = \"../dependencies/reactive_graph-0.2.16\", version = \"0.2.14\", features = [\"serde\"] }\nrustc-hash = \"2.1\"\nsend_wrapper = \"0.6\"\nserde = \"1\"\nserde_json = \"1\"\nslotmap = \"1.1\"\ntachys = { path = \"../dependencies/tachys-0.2.19\", version = \"0.2.15\", features = [\"reactive_graph\", \"oco\"] }\nthiserror = \"2\"\nthrow_error = { path = \"../dependencies/throw_error-0.3.1\", version = \"0.3.1\" }\ntyped-builder = \"0.23\"\ntyped-builder-macro = \"0.23\"\nwasm-bindgen = \"0.2\"\nwasm-bindgen-futures = \"0.4\"\nweb-sys = \"0.3\"\n\n[build-dependencies]\nrustc_version = \"0.4\"\n\n[lints.rust]\nunexpected_cfgs = { level = \"allow\" }\n",
    "vendor/web/zxs-web-core/README.md": "# zxs-web-core\n\n本目录是项目维护的 Rust CSR 运行时。 对外统一通过 zxs-web 使用；只启用 CSR，业务认证、传输和平台接入由项目独立实现。\n\n第三方基础来自 Leptos 0.8.19，以下保留原始 MIT 通知和全文。外部 reactive_graph、tachys 等 Cargo 包保留实际包名。\n\nZXS 的 `ForSnapshot` 在 Leptos 的逐行 owner 结构与 Tachys 的 keyed DOM 调和器之间整合逐键响应式快照。传输任务使用稳定操作编号作为 key：状态变化只发布该行的新数据；相同快照不通知该行消费者，展开的操作详情与焦点保留。移除 key 后重新出现会创建新行；每个快照的重复 key 在任何数据发布前被拒绝。这是本地新增运行时能力，原始 `For` 保留原语义。自有回归覆盖值更新、重排、相同值通知抑制、移除重建和重复 key；真实浏览器回归另外验证一次实际上传从 `uploading` 到 `published` 的 DOM、详情展开和焦点保留。\n\n```text\nMIT License\n\nCopyright (c) 2022 Greg Johnston\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n```\n",
    "vendor/web/zxs-web-core/src/lib.rs": "#![deny(missing_docs)]\n\n//! Browser CSR runtime used by the public `zxs-web` crate.\n//! Use `zxs_web::prelude::*` and the DOM builders from that facade.\n//! See README.md for the original third-party copyright and license notice.\n//! This product build contains only CSR; server rendering, hydration and server functions are excluded.\n\n#![cfg_attr(all(feature = \"nightly\", rustc_nightly), feature(fn_traits))]\n#![cfg_attr(all(feature = \"nightly\", rustc_nightly), feature(unboxed_closures))]\n\nextern crate self as zxs_web;\n\n/// Exports all the core types of the library.\npub mod prelude {\n    // Traits\n    // These should always be exported from the prelude\n    pub use reactive_graph::prelude::*;\n    pub use tachys::prelude::*;\n\n    // Collect the public CSR types for the facade's prelude.\n    mod export_types {\n        pub use crate::{\n            callback::*, children::*, component::*, control_flow::*, error::*, into_view::*,\n            mount::*, text_prop::*,\n        };\n        pub use leptos_dom::helpers::*;\n        pub use oco_ref::*;\n        pub use reactive_graph::{\n            actions::*,\n            computed::*,\n            effect::*,\n            graph::untrack,\n            owner::*,\n            signal::*,\n            wrappers::{read::*, write::*},\n        };\n        pub use tachys::{\n            reactive_graph::{bind::BindAttribute, node_ref::*, Suspend},\n            view::{fragment::Fragment, template::ViewTemplate},\n        };\n        pub use zxs_web_macro::*;\n    }\n    pub use export_types::*;\n}\n\n/// A standard way to wrap functions and closures to pass them to components.\npub use reactive_graph::callback;\n\n/// Types that can be passed as the `children` prop of a component.\npub mod children;\n\n/// Wrapper for intercepting component attributes.\npub mod attribute_interceptor;\n\n#[doc(hidden)]\n/// Traits used to implement component constructors.\npub mod component;\n\n/// Tools for handling errors.\npub mod error {\n    pub use throw_error::*;\n}\n\n/// CSR control-flow components such as `<Show>`, `<For>`, and `<ShowLet>`.\npub mod control_flow {\n    pub use crate::{animated_show::*, for_loop::*, for_snapshot::*, show::*, show_let::*};\n}\nmod animated_show;\n\nmod for_loop;\nmod for_snapshot;\nmod show;\nmod show_let;\n\n/// A component that allows rendering a component somewhere else.\npub mod portal;\n\n/// Types for reactive string properties for components.\npub mod text_prop;\n\n#[doc(hidden)]\npub use typed_builder;\n#[doc(hidden)]\npub use typed_builder_macro;\npub use zxs_web_macro::*;\nmod into_view;\npub use into_view::IntoView;\n#[doc(inline)]\npub use leptos_dom;\nmod provider;\n#[doc(inline)]\npub use tachys;\n/// Mount a browser CSR tree into the DOM and retain its reactive owner.\npub mod mount;\n#[doc(inline)]\npub use oco_ref as oco;\nmod from_form_data;\n#[doc(inline)]\npub use either_of as either;\n#[doc(inline)]\npub use reactive_graph as reactive;\n\n/// Provide and access data along the reactive graph, sharing data without directly passing arguments.\npub mod context {\n    pub use crate::provider::*;\n    pub use reactive_graph::owner::{provide_context, use_context};\n}\n\n/// HTML attribute types.\n#[doc(inline)]\npub use tachys::html::attribute as attr;\n/// HTML element types.\n#[doc(inline)]\npub use tachys::html::element as html;\n/// HTML event types.\n#[doc(no_inline)]\npub use tachys::html::event as ev;\n/// MathML element types.\n#[doc(inline)]\npub use tachys::mathml as math;\n/// SVG element types.\n#[doc(inline)]\npub use tachys::svg;\n\n/// Utilities for simple isomorphic logging to the console or terminal.\npub mod logging {\n    pub use leptos_dom::{debug_error, debug_log, debug_warn, error, log, warn};\n}\n\n/// Utilities for working with asynchronous tasks.\npub mod task {\n    use any_spawner::Executor;\n    use reactive_graph::computed::ScopedFuture;\n    use std::future::Future;\n\n    /// Spawns a thread-safe [`Future`].\n    ///\n    /// This will be run with the current reactive owner and observer using a [`ScopedFuture`].\n    #[track_caller]\n    #[inline(always)]\n    pub fn spawn(fut: impl Future<Output = ()> + Send + 'static) {\n        let fut = ScopedFuture::new(fut);\n\n        #[cfg(not(target_family = \"wasm\"))]\n        Executor::spawn(fut);\n\n        #[cfg(target_family = \"wasm\")]\n        Executor::spawn_local(fut);\n    }\n\n    /// Spawns a [`Future`] that cannot be sent across threads.\n    #[track_caller]\n    #[inline(always)]\n    pub fn spawn_local(fut: impl Future<Output = ()> + 'static) {\n        Executor::spawn_local(fut)\n    }\n\n    /// Waits until the next \"tick\" of the current async executor.\n    pub async fn tick() {\n        Executor::tick().await\n    }\n\n    pub use reactive_graph::{spawn_local_scoped, spawn_local_scoped_with_cancellation};\n}\n\n// these reexports are used in islands\n#[cfg(feature = \"islands\")]\n#[doc(hidden)]\npub use serde;\n#[doc(hidden)]\npub use serde_json;\n#[cfg(feature = \"tracing\")]\n#[doc(hidden)]\npub use tracing;\n#[doc(hidden)]\npub use wasm_bindgen;\n#[doc(hidden)]\npub use web_sys;\n\n#[doc(hidden)]\npub mod __reexports {\n    pub use send_wrapper;\n    pub use wasm_bindgen_futures;\n}\n",
