# 验证目录只保留说明与检查代码；运行后生成的 JSON、日志、截图、trace 等不入库。
# 先开放子目录供 Git 查找源码，后面的缓存和凭据规则继续生效。
/tests/evidence/**
/demos/*/tests/evidence/**
/demos/*/tests/history/**
!/tests/evidence/**/
!/demos/*/tests/evidence/**/
!/demos/*/tests/history/**/
!/tests/evidence/**/*.md
!/tests/evidence/**/*.rs
!/tests/evidence/**/*.mjs
!/tests/evidence/**/*.py
!/tests/evidence/**/*.sh
# Source classification manifest, not a generated acceptance result.
!/tests/evidence/probes.json
!/demos/*/tests/evidence/**/*.md
!/demos/*/tests/evidence/**/*.rs
!/demos/*/tests/evidence/**/*.mjs
!/demos/*/tests/evidence/**/*.py
!/demos/*/tests/evidence/**/*.sh
!/demos/*/tests/history/**/*.md
!/demos/*/tests/history/**/*.rs
!/demos/*/tests/history/**/*.mjs
!/demos/*/tests/history/**/*.py
!/demos/*/tests/history/**/*.sh

# Cargo：覆盖所有独立工作区及将来新增的 crate；保留 Cargo.lock。
target/
/.rustc_info.json
/.cargo/registry/
/.cargo/git/
*.rs.bk

# 生成的 Web／演示发行包与原生宿主配置。
/web/dist/
/web/pkg/
/web/.build-lock
/web/.dist-staging/
/web/.dist-backup/
/demos/*/dist/
/demos/*/.build-lock
/demos/*/.dist-staging/
/demos/*/.dist-backup/
/apps/host/gen/
/apps/host/permissions/autogenerated/
/dist/
/build/
/out/
/artifacts/

# 本地运行池、待提交数据与临时文件。web/runtime/ 是源码，必须保留。
/runtime/
/zxs-data/
/logs/
/tmp/
/.tmp/
/.cache/
.direnv/
.envrc
*.tmp
*.temp
*.bak
*.orig
*.rej
*.pid
*.pid.lock
*.sock

# 上游 crate 的原始清单是来源材料，不是补丁残留。
!/vendor/**/Cargo.toml.orig

# 本地凭据及环境覆盖；示例配置仍可提交。
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template
!.envrc.example
/.aws/
/.codex/
/.ssh/
/secrets/
/credentials/
/.cargo/credentials
/.cargo/credentials.toml
/apps/host/signing/*.key
/apps/host/signing/*.p12
/apps/host/signing/*.pfx
/apps/host/signing/*.jks
/apps/host/signing/*.keystore

# 浏览器验证依赖、报告和覆盖率缓存。
node_modules/
playwright-report/
test-results/
blob-report/
coverage/
.nyc_output/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.venv/
venv/
*.profraw
*.profdata
lcov.info
tarpaulin-report.html
cobertura.xml

# 日志属于本地生成物；摘要结论和复现命令放在 README 中。
*.log
*.log.*

# 编辑器与操作系统缓存；保留可共享的 VS Code 项目配置。
.idea/
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
*.sw[a-p]
.#*
\#*#
*~
.DS_Store
._*
.AppleDouble/
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
__pycache__/
*.pyc
*.pyo
