[Unit]
Description=XCS full-file storage API
Documentation=file:/opt/xcs/README.md
After=local-fs.target network.target
RequiresMountsFor=/srv/xcs/disks/P01 /srv/xcs/disks/B01 /srv/xcs/disks/C01

[Service]
Type=simple
User=xcs
Group=xcs
UMask=0077
StateDirectory=xcs
StateDirectoryMode=0700
RuntimeDirectory=xcs
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/xcs
ExecStartPre=/usr/bin/test -f /var/lib/xcs/state/config.json
ExecStart=/opt/xcs/bin/xcs --root /var/lib/xcs/state serve --listen 127.0.0.1:7400 --external-origin https://xcs.example.com --web-dir /opt/xcs/web
KillSignal=SIGINT
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateMounts=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/xcs /run/xcs /srv/xcs/disks/P01 /srv/xcs/disks/B01 /srv/xcs/disks/C01
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
