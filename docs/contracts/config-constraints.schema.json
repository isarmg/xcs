{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "完整配置的协议断言及运行额度投影",
  "$defs": {
    "UInt64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])"
    }
  },
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "replica_members": {
          "const": 3
        },
        "decision_members": {
          "const": 2
        },
        "recovery_evidence_members": {
          "const": 2
        },
        "publish_after_all_members": {
          "const": true
        },
        "acknowledge_after_all_members": {
          "const": true
        },
        "max_inflight_decision_slots": {
          "const": 1
        },
        "require_fenced_membership_change": {
          "const": true
        },
        "allow_automatic_degraded_writes": {
          "const": false
        },
        "sqlite_role": {
          "const": "rebuildable-index"
        },
        "application_log": {
          "const": true
        }
      },
      "required": [
        "replica_members",
        "decision_members",
        "recovery_evidence_members",
        "publish_after_all_members",
        "acknowledge_after_all_members",
        "max_inflight_decision_slots",
        "require_fenced_membership_change",
        "allow_automatic_degraded_writes",
        "sqlite_role",
        "application_log"
      ],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "minimum_disks_for_protected_write": {
          "const": 3
        },
        "allow_cross_version_reflink": {
          "const": false
        },
        "allow_content_hardlinks": {
          "const": false
        },
        "allow_implicit_content_deduplication": {
          "const": false
        },
        "allow_cross_tree_dependencies": {
          "const": false
        }
      },
      "required": [
        "minimum_disks_for_protected_write",
        "allow_cross_version_reflink",
        "allow_content_hardlinks",
        "allow_implicit_content_deduplication",
        "allow_cross_tree_dependencies"
      ],
      "additionalProperties": false
    },
    "branches": {
      "type": "object",
      "properties": {
        "creation_mode": {
          "const": "full"
        },
        "materialize_all_files_on_create": {
          "const": true
        },
        "merge_behavior": {
          "const": "link-only"
        },
        "merge_creates_content_version": {
          "const": false
        },
        "merge_updates_branch_head": {
          "const": false
        },
        "allow_history_rewrite": {
          "const": false
        }
      },
      "required": [
        "creation_mode",
        "materialize_all_files_on_create",
        "merge_behavior",
        "merge_creates_content_version",
        "merge_updates_branch_head",
        "allow_history_rewrite"
      ],
      "additionalProperties": false
    },
    "resource_limits": {
      "type": "object",
      "properties": {
        "workspaces_per_account": {
          "type": "integer",
          "minimum": 1
        },
        "uploads_per_account": {
          "type": "integer",
          "minimum": 1
        },
        "uploads_per_pool": {
          "type": "integer",
          "minimum": 1
        },
        "staging_bytes_per_account": {
          "$ref": "#/$defs/UInt64"
        },
        "staging_bytes_per_pool": {
          "$ref": "#/$defs/UInt64"
        },
        "handles_per_session": {
          "type": "integer",
          "minimum": 1
        },
        "handles_per_pool": {
          "type": "integer",
          "minimum": 1
        },
        "queued_tasks_per_pool": {
          "type": "integer",
          "minimum": 1
        },
        "default_page_items": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_page_items": {
          "type": "integer",
          "minimum": 1
        },
        "page_snapshot_ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "event_retention_days": {
          "type": "integer",
          "minimum": 1
        },
        "event_retention_bytes": {
          "$ref": "#/$defs/UInt64"
        },
        "workspace_reminder_days": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "workspaces_per_account",
        "uploads_per_account",
        "uploads_per_pool",
        "staging_bytes_per_account",
        "staging_bytes_per_pool",
        "handles_per_session",
        "handles_per_pool",
        "queued_tasks_per_pool",
        "default_page_items",
        "maximum_page_items",
        "page_snapshot_ttl_seconds",
        "event_retention_days",
        "event_retention_bytes",
        "workspace_reminder_days"
      ],
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "properties": {
        "decision_warning_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "decision_critical_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "queue_warning_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "decision_warning_seconds",
        "decision_critical_seconds",
        "queue_warning_seconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "metadata",
    "storage",
    "branches",
    "resource_limits",
    "observability"
  ],
  "additionalProperties": false
}
